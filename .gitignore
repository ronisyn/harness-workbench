# Dependencies
node_modules/

# Environment & secrets
.env
.env.*
!.env.example
# 凭据文档（C-18：唯一访问路径 server/credentials.js）——密钥绝不进版本库
.credentials.yaml

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp

# Runtime
.runtime/
data/
tmp/
.cache/
# 自动 checkpoint 快照（写类工具执行前的文件时间线，undo_checkpoint 用）：纯本机运行态，不进仓库
.rw-checkpoints/
# 实时实测脚本的临时文件（scripts/ra26-waitsides.mjs 等）
.ra26-waitsides.tmp

# Skills (F15) - runtime-authored skill content
skills/

# 溢出明细（server/tools/spill.js）：默认落盘位置是 RW_WORKSPACE 下的 spill/，
# 本机跑夹具/脚本时 RW_WORKSPACE 可能落在仓库根，运行态产物就会出现在工作区里
# ——磁盘运行态（可清理、可按需重建），不进版本库。服务器上 RW_WORKSPACE 在平台目录之外，不受影响。
spill/
