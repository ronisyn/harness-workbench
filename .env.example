# Roni Workbench 环境变量模板
# 复制为 .env 后填入真实值（.env 已被 gitignore，不会进仓库）
# 服务器正式凭据统一存 /root/.rw-keys.env，由部署脚本注入

# 端口
PORT=3000

# 数据库（三环境隔离：DEV 本地 / TEST rw_test / PROD rw_prod）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rw_app
DB_PASS=
DB_NAME=rw_dev

# 会话
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_DAYS=5

# ---- 模型 API Key（OpenAI 兼容）----
# DeepSeek
DEEPSEEK_API_KEY=
# 智谱 GLM
GLM_API_KEY=
# 豆包/火山方舟（base: https://ark.cn-beijing.volces.com/api/v3）
VOLC_ARK_API_KEY=
# Kimi（base: https://api.moonshot.cn/v1）
MOONSHOT_API_KEY=
# 通义千问（base: https://dashscope.aliyuncs.com/compatible-mode/v1）
DASHSCOPE_API_KEY=
# 腾讯 TokenHub（base: https://tokenhub.tencentmaas.com/v1）
TOKENHUB_API_KEY=
# 百度千帆（base: https://qianfan.baidubce.com/v2）
QIANFAN_API_KEY=
# MiniMax（base: https://api.minimaxi.com/v1）
MINIMAX_API_KEY=
# 硅基流动（base: https://api.siliconflow.cn/v1）
SILICONFLOW_API_KEY=
# OpenRouter（base: https://openrouter.ai/api/v1）
OPENROUTER_API_KEY=
