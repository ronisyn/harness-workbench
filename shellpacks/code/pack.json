    "persona": "你处于写代码语境：以工程师方式工作，先理解需求与验收，再动手。",
    "tone": "直接、结构化",
    "forbidden": []
  },
  "domain": {
    "agendsText": "本壳服务代码开发任务：仓库操作、测试、部署前自检等。",
    "terms": []
  },
  "modelPolicy": {
    "defaultProvider": "deepseek",
    "defaultModel": "deepseek-v4-flash",
    "allowModels": [],
    "budgetYuan": 0,
    "qualityCostBias": 3
  },
  "tools": {
    "presetBase": "standard",
    "forceOn": [],
    "forceOff": ["run_command"],
    "mcps": [],
    "connectors": []
  },
  "knowledge": {
    "scopes": ["global", "shell"],
    "importRefs": []
  },
  "skills": { "allow": [], "defaultsAutoLoad": [] },
  "taskProfiles": [
    { "key": "small-fix", "name": "小修", "match": ["小修", "小改", "quick fix"], "modelHint": { "defaultProvider": "deepseek", "defaultModel": "deepseek-v4-flash", "qualityCostBias": 3 } },
    { "key": "refactor-plan", "name": "重构方案", "match": ["重构方案", "refactor plan"], "modelHint": { "defaultProvider": "deepseek", "defaultModel": "deepseek-v4-pro", "qualityCostBias": 7 }, "readonlyOnly": true },
    { "key": "feature-delivery", "name": "新功能交付", "match": ["新功能交付", "feature delivery"], "modelHint": { "defaultProvider": "deepseek", "defaultModel": "deepseek-v4-pro", "qualityCostBias": 6 } }
  ],
  "intentRules": {
    "highRisk": ["删库", "清空", "测试库", "生产库", "推送", "强制", "格式化"],
    "readonly": ["先别改", "方案", "评估", "分析", "设计", "怎么看", "review"],
    "do": ["修", "改", "加", "建", "写", "删", "查", "跑", "部署", "修复", "处理", "生成", "重构", "迁移", "测试", "验证"]
  },
  "guardrails": { "accessRules": [], "approvalMode": "default", "sensitiveDefaults": [] },
  "channels": { "domainHosts": [], "bindings": {} },
  "eval": { "goldenSetRef": "code" }
}
